<%- include("../partials/header", { title: "Users" }) %> <%-
include("../partials/navbar-admin") %>

<div class="max-w-8xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-6">Users</h1>

  <% if (!users || users.length === 0) { %>
  <p class="text-gray-600">No users found.</p>
  <% } else { %>
  <div class="overflow-x-auto">
    <tbody class="block md:table-row-group divide-y divide-gray-200">
      <% users.forEach(user => { %>
      <tr
        class="block mb-4 md:table-row hover:bg-gray-50 border md:border-none"
      >
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">ID: </span><%= user.id %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Name: </span><%= user.name %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Email: </span><%= user.email %>
        </td>
        <td class="block md:table-cell px-4 py-2 capitalize">
          <span class="font-semibold md:hidden">Role: </span><%= user.role %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">DOB: </span>
          <%= user.date_of_birth ? new
          Date(user.date_of_birth).toLocaleDateString() : "-" %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Gender: </span><%= user.gender
          || "-" %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">National ID: </span><%=
          user.national_id || "-" %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Department: </span><%=
          user.department_name || "-" %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Created At: </span><%= new
          Date(user.created_at).toLocaleString() %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <span class="font-semibold md:hidden">Updated At: </span><%= new
          Date(user.updated_at).toLocaleString() %>
        </td>
        <td class="block md:table-cell px-4 py-2">
          <div class="flex flex-wrap md:flex-nowrap gap-2">
            <form action="/admin/citizen/<%= user.id %>/delete" method="POST">
              <button
                type="submit"
                class="bg-red-600 hover:bg-red-700 text-white text-sm px-3 py-1 rounded shadow-sm transition"
                onclick="return confirm('Are you sure you want to delete this user?')"
              >
                Remove
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </div>

  <% } %>
</div>

<%- include("../partials/footer") %>
