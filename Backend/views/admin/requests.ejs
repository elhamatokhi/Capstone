<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %>

<!-- Requests Table -->
<div class="bg-white shadow rounded-lg p-4">
  <h3 class="font-semibold mb-2">All requests</h3>
  <table class="w-full text-left">
    <thead>
      <tr>
        <th class="px-2 py-1">Request ID</th>
        <th class="px-2 py-1">Status</th>
        <th class="px-2 py-1">Create at</th>
        <th class="px-2 py-1">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(request => { %>
      <tr>
        <td class="px-2 py-1"><%= request.id %></td>
        <td class="px-2 py-1"><%= request.status %></td>
        <td class="px-2 py-1"><%= request.created_at %></td>
        <td class="py-3 px-4">
          <a
            href="/requests/<%= request.id %>"
            class="text-blue-600 hover:underline"
            >View</a
          >
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
