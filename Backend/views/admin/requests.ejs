<%- include('../partials/header', { title: "Admin Dashboard" }) %> 
<%- include('../partials/navbar-admin') %>

<% if (success_msg && success_msg.length > 0) { %>
  <div
    id="flash-success"
    class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md"
  >
    <%= success_msg[0] %>
  </div>
<% } %>

<script>
  setTimeout(() => {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 3000);
</script>

<!-- Search and Filter Form -->
<div class="max-w-8xl mx-auto p-4 sm:p-6 mb-4 mt-2 bg-white shadow rounded-lg">
  <form
    action="/admin/requests"
    method="GET"
    class="grid grid-cols-1 sm:grid-cols-2 md:flex md:flex-wrap md:items-center gap-2"
  >
    <input
      type="text"
      name="requestId"
      placeholder="Request ID"
      value="<%= filters.requestId || '' %>"
      class="border rounded px-2 py-1 w-full md:w-auto"
    />

    <input
      type="text"
      name="username"
      placeholder="Citizen Name"
      value="<%= filters.username || '' %>"
      class="border rounded px-2 py-1 w-full md:w-auto"
    />

    <select
      name="status"
      class="border rounded px-2 py-1 w-full md:w-auto"
    >
      <option value="">-- Status --</option>
      <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
      <option value="submitted" <%= filters.status === 'submitted' ? 'selected' : '' %>>Submitted</option>
      <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
      <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
    </select>

    <select
      name="service_id"
      class="border rounded px-2 py-1 w-full md:w-auto"
    >
      <option value="">-- Service --</option>
      <% services.forEach(service => { %>
        <option value="<%= service.id %>" <%= filters.service_id == service.id ? 'selected' : '' %>>
          <%= service.name %>
        </option>
      <% }) %>
    </select>

    <div class="flex items-center gap-2 w-full md:w-auto">
      <label for="startDate" class="text-sm text-gray-600">From:</label>
      <input
        type="date"
        name="startDate"
        value="<%= filters.startDate || '' %>"
        class="border rounded px-2 py-1 w-full md:w-auto"
      />
    </div>

    <div class="flex items-center gap-2 w-full md:w-auto">
      <label for="endDate" class="text-sm text-gray-600">To:</label>
      <input
        type="date"
        name="endDate"
        value="<%= filters.endDate || '' %>"
        class="border rounded px-2 py-1 w-full md:w-auto"
      />
    </div>

    <button
      type="submit"
      class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600 w-full md:w-auto"
    >
      Search
    </button>

    <a
      href="/admin/requests"
      class="bg-gray-400 text-white px-3 py-1 rounded hover:bg-gray-500 w-full md:w-auto text-center"
    >
      Clear
    </a>
  </form>
</div>
