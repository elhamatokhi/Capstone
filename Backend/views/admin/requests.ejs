<!-- Requests Table (hidden on small screens) -->
<div class="bg-white shadow rounded-lg p-4 overflow-auto hidden md:block">
  <h3 class="font-semibold mb-4">All Requests</h3>

  <% if (requests.length > 0) { %>
    <table class="w-full whitespace-nowrap">
      <thead class="bg-gray-50 border-b-2 border-gray-200">
        <tr>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-24">Request ID</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-24">Status</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Citizen</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Department</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Service</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-32">Created At</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-20">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% requests.forEach(request => { %>
          <tr class="odd:bg-white even:bg-gray-50">
            <!-- Request ID -->
            <td class="p-3 text-sm text-gray-700">
              <a href="/requests/<%= request.id %>" class="font-bold text-blue-500 hover:underline">
                <%= request.id %>
              </a>
            </td>

            <!-- Status Badge -->
            <td class="p-3 text-sm">
              <% if (request.status === "approved") { %>
                <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-green-800 bg-green-200 bg-opacity-40 rounded-lg">
                  Approved
                </span>
              <% } else if (request.status === "rejected") { %>
                <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-red-800 bg-red-200 bg-opacity-40 rounded-lg">
                  Rejected
                </span>
              <% } else if (request.status === "under_review") { %>
                <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-yellow-800 bg-yellow-200 bg-opacity-40 rounded-lg">
                  Under Review
                </span>
              <% } else { %>
                <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-gray-800 bg-gray-200 bg-opacity-40 rounded-lg">
                  Submitted
                </span>
              <% } %>
            </td>

            <!-- Other fields -->
            <td class="p-3 text-sm text-gray-700"><%= request.citizen_name %></td>
            <td class="p-3 text-sm text-gray-700"><%= request.department_id %></td>
            <td class="p-3 text-sm text-gray-700"><%= request.service_name %></td>
            <td class="p-3 text-sm text-gray-500"><%= request.created_at %></td>

            <!-- Actions -->
            <td class="p-3 text-sm">
              <a href="/requests/<%= request.id %>" class="text-blue-600 hover:underline">View</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="text-gray-500 mt-4">No requests matched your search.</p>
  <% } %>
</div>

<!-- Mobile Card Layout (hidden on md+) -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:hidden">
  <% if (requests.length > 0) { %>
    <% requests.forEach(request => { %>
      <div class="bg-white p-4 rounded-lg shadow space-y-3">
        <!-- Top Row -->
        <div class="flex items-center justify-between">
          <a href="/requests/<%= request.id %>" class="text-blue-500 font-bold hover:underline">
            #<%= request.id %>
          </a>
          <span class="text-sm text-gray-500"><%= request.created_at %></span>
        </div>

        <!-- Status -->
        <div>
          <% if (request.status === "approved") { %>
            <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-green-800 bg-green-200 bg-opacity-40 rounded-lg">
              Approved
            </span>
          <% } else if (request.status === "rejected") { %>
            <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-red-800 bg-red-200 bg-opacity-40 rounded-lg">
              Rejected
            </span>
          <% } else if (request.status === "under_review") { %>
            <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-yellow-800 bg-yellow-200 bg-opacity-40 rounded-lg">
              Under Review
            </span>
          <% } else { %>
            <span class="p-1.5 text-xs font-medium uppercase tracking-wider text-gray-800 bg-gray-200 bg-opacity-40 rounded-lg">
              Submitted
            </span>
          <% } %>
        </div>

        <!-- Citizen & Service -->
        <div class="text-sm text-gray-700">
          <p><span class="font-medium">Citizen:</span> <%= request.citizen_name %></p>
          <p><span class="font-medium">Dept:</span> <%= request.department_id %></p>
          <p><span class="font-medium">Service:</span> <%= request.service_name %></p>
        </div>

        <!-- Actions -->
        <div>
          <a href="/requests/<%= request.id %>" class="text-blue-600 hover:underline text-sm">View Details</a>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p class="text-gray-500 mt-4">No requests matched your search.</p>
  <% } %>
</div>


<%- include('../partials/footer') %>
