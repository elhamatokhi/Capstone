<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %> <% if (success_msg && success_msg.length
> 0) { %>
<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md"
>
  <%= success_msg[0] %>
</div>
<% } %>
<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);
</script>

<div class="max-w-5xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">Available Services</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (services && services.length) { %> <% services.forEach(service => { %>
    <div class="p-4 bg-white shadow rounded-lg">
      <h3 class="text-lg font-semibold"><%= service.name %></h3>
      <p class="text-sm text-gray-600"><%= service.description %></p>
      <% if(service.is_active) { %>
      <h3 class="text-lg font-semibold bg-green-500">Active</h3>
      <% } else { %>
      <h3 class="text-lg font-semibold bg-red-500">Not avaialbe</h3>
      <% } %> <% if(service.fee > 0) { %>
      <p class="mt-2 text-red-600 font-bold">Fee: $<%= service.fee %></p>
      <% } else { %>
      <p class="mt-2 text-green-600 font-semibold">Free</p>
      <% } %>
      <form
        action="/admin/services/<%= service.id %>/edit"
        method="GET"
        class="inline"
      >
        <button
          class="bg-blue-500 text-white px-2 py-1 rounded hover:bg-blue-600"
        >
          Edit
        </button>
      </form>
      <form
        action="/admin/services/<%= service.id %>/status"
        method="POST"
        class="inline"
      >
        <button
          type="submit"
          class="px-2 py-1 rounded text-white <%= service.is_active ? 'bg-red-500 hover:bg-red-600' : 'bg-green-500 hover:bg-green-600' %>"
        >
          <%= service.is_active ? 'Deactivate' : 'Activate' %>
        </button>
      </form>
    </div>
    <% }) %> <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
