<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %>

<div class="max-w-6xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">Welcome, <%= user.name %></h2>

  <a href="/admin/services">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-4 bg-white shadow rounded-lg">
      <h3 class="font-semibold">Services</h3>
         <p><%= services.length %></p>
      <p class="text-gray-500">Manage all available services here.</p>
    </div>
    </a>
    <a href="/admin/requests">
      <div class="p-4 bg-white shadow rounded-lg">
        <h3 class="font-semibold">Requests</h3>
        <p><%= requests.length %></p>
        <p class="text-gray-500">Review and track citizen requests.</p>
      </div>
    </a>
    <a href="/admin/users">
      <div class="p-4 bg-white shadow rounded-lg">
        <h3 class="font-semibold">Users</h3>
        <p><%= users.length %></p>
        <p class="text-gray-500">View and manage registered users.</p>
      </div>
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
