<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %>

<div class="max-w-6xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">Welcome, <%= user.name %></h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-4 bg-white shadow rounded-lg">
      <h3 class="font-semibold">Services</h3>
      <p class="text-gray-500">Manage all available services here.</p>
    </div>
    <div class="p-4 bg-white shadow rounded-lg">
      <h3 class="font-semibold">Requests</h3>
      <p class="text-gray-500">Review and track citizen requests.</p>
    </div>
    <div class="p-4 bg-white shadow rounded-lg">
      <h3 class="font-semibold">Users</h3>
      <p class="text-gray-500">View and manage registered users.</p>
    </div>
  </div>
</div>

<!-- Requests Table -->
<div class="bg-white shadow rounded-lg p-4">
  <h3 class="font-semibold mb-2">All requests</h3>
  <table class="w-full text-left">
    <thead>
      <tr>
        <th class="px-2 py-1">Request ID</th>
        <th class="px-2 py-1">Status</th>
        <th class="px-2 py-1">Create at</th>
        <th class="px-2 py-1">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(request => { %>
      <tr>
        <td class="px-2 py-1"><%= request.id %></td>
        <td class="px-2 py-1"><%= request.status %></td>
        <td class="px-2 py-1"><%= request.created_at %></td>
        <td class="py-3 px-4">
          <a
            href="/staff/requests/<%= request.id %>"
            class="text-blue-600 hover:underline"
            >View</a
          >
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
