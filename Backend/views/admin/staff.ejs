<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %> <% if (success_msg && success_msg.length
> 0) { %>
<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md"
>
  <%= success_msg[0] %>
</div>
<% } %>
<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);
</script>

<body class="bg-gray-100 min-h-screen p-6">
  <div class="container mx-auto">
    <h1 class="text-3xl font-bold mb-6 text-center">Staff Management</h1>

    <!-- Add Staff Form -->
    <div class="bg-white p-6 rounded-lg shadow-md mb-6">
      <h2 class="text-xl font-semibold mb-4">Add New Staff</h2>
      <form action="/admin/add-user" method="POST" class="flex flex-col gap-4">
        <input
          type="text"
          name="name"
          placeholder="name"
          class="border px-3 py-2 rounded"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          class="border px-3 py-2 rounded"
        />
        <input
          type="password"
          name="password"
          placeholder="Password"
          class="border px-3 py-2 rounded"
        />
        <select name="department_id" class="border px-3 py-2 rounded" required>
          <option value="">Select Department</option>
          <% departments.forEach(dept => { %>
          <option value="<%= dept.id %>"><%= dept.name %></option>
          <% }) %>
        </select>

        <select name="role" class="border px-3 py-2 rounded">
          <option value="staff">Staff</option>
          <option value="department_head">Department Head</option>
        </select>
        <button
          type="submit"
          class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
        >
          Add Staff
        </button>
      </form>
    </div>
    <!-- Staff Table -->
    <!-- Staff Table -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-xl font-semibold mb-4">All Staff</h2>

      <div class="overflow-x-auto">
        <table
          class="min-w-full border-collapse border border-gray-300 md:table"
        >
          <thead class="hidden md:table-header-group">
            <tr class="bg-gray-200">
              <th class="border border-gray-300 px-4 py-2 text-left">Name</th>
              <th class="border border-gray-300 px-4 py-2 text-left">Email</th>
              <th class="border border-gray-300 px-4 py-2 text-left">Role</th>
              <th class="border border-gray-300 px-4 py-2 text-left">
                Department ID
              </th>
              <th class="border border-gray-300 px-4 py-2 text-left">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            <% if (staff && staff.length > 0) { %> <% staff.forEach(member => {
            %>
            <tr
              class="block mb-4 md:table-row border border-gray-300 md:border-none"
            >
              <td
                class="block md:table-cell px-4 py-2 font-semibold"
                data-label="Name"
              >
                <%= member.name %>
              </td>
              <td
                class="block md:table-cell px-4 py-2 border border-gray-300 px-4 py-2"
                data-label="Email"
              >
                <%= member.email %>
              </td>
              <td
                class="block md:table-cell px-4 py-2 border border-gray-300 px-4 py-2"
                data-label="Role"
              >
                <%= member.role %>
              </td>
              <td
                class="block md:table-cell px-4 py-2 border border-gray-300 px-4 py-2"
                data-label="Department ID"
              >
                <%= member.department_id %>
              </td>
              <td class="block md:table-cell px-4 py-2" data-label="Actions">
                <div class="flex flex-wrap md:flex-nowrap gap-2 justify-start">
                  <form
                    action="/admin/staff/<%= member.id %>/edit"
                    method="GET"
                  >
                    <button
                      type="submit"
                      class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600"
                    >
                      Edit
                    </button>
                  </form>
                  <form
                    action="/admin/staff/<%= member.id %>/delete"
                    method="POST"
                  >
                    <button
                      type="submit"
                      class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700"
                      onclick="return confirm('Are you sure you want to delete this staff member?')"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %> <% } else { %>
            <tr class="block md:table-row">
              <td colspan="5" class="block text-center p-4 md:table-cell">
                No staff found
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
