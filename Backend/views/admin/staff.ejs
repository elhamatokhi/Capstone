<%- include('../partials/header', { title: "Admin Dashboard" }) %> <%-
include('../partials/navbar-admin') %> <% if (success_msg && success_msg.length
> 0) { %>
<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md"
>
  <%= success_msg[0] %>
</div>
<% } %>
<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);
</script>

<body class="bg-gray-100 min-h-screen p-6">
  <div class="container mx-auto">
    <h1 class="text-3xl font-bold mb-6 text-center">Staff Management</h1>

    <!-- Add Staff Form -->
    <div class="bg-white p-6 rounded-lg shadow-md mb-6">
      <h2 class="text-xl font-semibold mb-4">Add New Staff</h2>
      <form action="/admin/add-user" method="POST" class="flex flex-col gap-4">
        <input
          type="text"
          name="name"
          placeholder="name"
          class="border px-3 py-2 rounded"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          class="border px-3 py-2 rounded"
        />
        <input
          type="password"
          name="password"
          placeholder="Password"
          class="border px-3 py-2 rounded"
        />
        <select name="department_id" class="border px-3 py-2 rounded" required>
          <option value="">Select Department</option>
          <% departments.forEach(dept => { %>
          <option value="<%= dept.id %>"><%= dept.name %></option>
          <% }) %>
        </select>

        <select name="role" class="border px-3 py-2 rounded">
          <option value="staff">Staff</option>
          <option value="department_head">Department Head</option>
        </select>
        <button
          type="submit"
          class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
        >
          Add Staff
        </button>
      </form>
    </div>
    <!-- Staff Table -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-xl font-semibold mb-4">All Staff</h2>
      <table class="w-full border-collapse border border-gray-300">
        <thead>
          <tr class="bg-gray-200">
            <th class="border border-gray-300 px-4 py-2">Name</th>
            <th class="border border-gray-300 px-4 py-2">Email</th>
            <th class="border border-gray-300 px-4 py-2">Role</th>
            <th class="border border-gray-300 px-4 py-2">Department ID</th>
            <th class="border border-gray-300 px-4 py-2">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (staff && staff.length > 0) { %> <% staff.forEach(member => { %>
          <tr>
            <td class="border border-gray-300 px-4 py-2"><%= member.name %></td>
            <td class="border border-gray-300 px-4 py-2">
              <%= member.email %>
            </td>
            <td class="border border-gray-300 px-4 py-2"><%= member.role %></td>
            <td class="border border-gray-300 px-4 py-2">
              <%= member.department_id %>
            </td>
            <td class="border border-gray-300 px-4 py-2 flex gap-2">
              <!-- Edit Form -->
              <form
                action="/admin/staff/<%= member.id %>/edit"
                method="GET"
                class="inline"
              >
                <input type="hidden" name="name" value="<%= member.name %>" />
                <input type="hidden" name="email" value="<%= member.email %>" />
                <input type="hidden" name="role" value="<%= member.role %>" />
                <button
                  type="submit"
                  class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600"
                >
                  Edit
                </button>
              </form>

              <!-- Delete Form -->
              <form
                action="/admin/staff/<%= member.id %>/delete"
                method="POST"
                class="inline"
              >
                <button
                  type="submit"
                  class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700"
                  onclick="return confirm('Are you sure you want to delete this staff member?')"
                >
                  Delete
                </button>
              </form>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="4" class="text-center p-4">No staff found</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
