<%- include('./partials/header', { title: "Edit Profile" }) %> <%-
include(navbarPartial) %>

<div class="max-w-xl mx-auto p-8 bg-white shadow rounded-lg mt-8">
  <h1 class="text-2xl font-bold mb-6 text-blue-700">Edit Profile</h1>
  <form action="/profile/edit" method="POST" class="space-y-4">
    <div>
      <label for="name" class="block font-semibold mb-1">Full Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= user.name %>"
        required
        class="w-full border rounded px-3 py-2"
      />
    </div>
    <div>
      <label for="email" class="block font-semibold mb-1">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= user.email %>"
        required
        class="w-full border rounded px-3 py-2"
      />
    </div>
    <div>
      <label for="national_id" class="block font-semibold mb-1"
        >National ID</label
      >
      <input
        type="text"
        id="national_id"
        name="national_id"
        value="<%= user.national_id %>"
        required
        class="w-full border rounded px-3 py-2"
      />
    </div>
    <div>
      <label for="date_of_birth" class="block font-semibold mb-1"
        >Date of Birth</label
      >
      <input
        type="date"
        id="date_of_birth"
        name="date_of_birth"
        value="<%= user.date_of_birth ? user.date_of_birth.toISOString().slice(0,10) : '' %>"
        required
        class="w-full border rounded px-3 py-2"
      />
    </div>
    <button
      type="submit"
      class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700"
    >
      Save Changes
    </button>
  </form>
</div>

<%- include('./partials/footer') %>
