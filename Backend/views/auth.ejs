<!-- views/auth.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>
      <%= formType === 'login' ? 'Login' : 'Register' %> | E-Government Services
    </title>
    <link rel="stylesheet" href="./css/styles.css" />
  </head>
  <body>
    <header>
      <h1><%= formType === 'login' ? 'Login' : 'Register' %></h1>
      <nav>
        <a href="/dashboard">Home</a>
      </nav>
    </header>

    <main>
      <a href="/auth/google">Login with google</a>
      <% if (formType === 'login') { %>
      <form action="/login" method="POST">
        <label>Email:</label>
        <input type="email" name="email" required />
        <label>Password:</label>
        <input type="password" name="password" required />
        <button type="submit">Login</button>
        <p>Don't have an account? <a href="/register">Register</a></p>
      </form>
      <% } else { %>
      <form action="/register" method="POST">
        <label>Name:</label>
        <input type="text" name="name" required />

        <label for="email" class="font-semibold">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="you@example.com"
          required
          class="w-full border rounded px-3 py-2"
        />

        <label>Password:</label>
        <input type="password" name="password" required />

        <label for="gender" class="font-semibold">Gender</label>
        <select
          id="gender"
          name="gender"
          required
          class="w-full border rounded px-3 py-2"
        >
          <option value="">Select Gender</option>
          <option value="female">Female</option>
          <option value="make">Male</option>
          <option value="other">Other</option>
        </select>

        <label for="date_of_birth" class="font-semibold">Date Of Birth</label>
        <input
          type="date"
          id="date_of_birth"
          name="date_of_birth"
          required
          class="w-full border rounded px-3 py-2"
        />

        <label for="national_id" class="font-semibold">National Id</label>
        <input
          type="text"
          id="national_id"
          name="national_id"
          placeholder="H13323424"
          class="w-full border rounded px-3 py-2"
        />

        <button type="submit">Register</button>
        <p>Already have an account? <a href="/login">Login</a></p>
      </form>
      <% } %>
    </main>

    <footer>
      <p>&copy; 2025 FoodieHub</p>
    </footer>
  </body>
</html>
