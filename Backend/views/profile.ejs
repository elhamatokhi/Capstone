<%- include('./partials/header', { title: "Profile" }) %> <%-
include(navbarPartial) %> <% if (success_msg && success_msg.length > 0) { %>
<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md"
>
  <%= success_msg[0] %>
</div>
<% } %>
<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);

  const btn = document.getElementById("notif-btn");
  const dropdown = document.getElementById("notif-dropdown");

  btn.addEventListener("click", () => {
    dropdown.classList.toggle("hidden");
  });

  // Optional: close dropdown if clicked outside
  window.addEventListener("click", (e) => {
    if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>
<div class="max-w-6xl mx-auto p-6">
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Profile Card -->
    <div
      class="bg-white rounded-2xl shadow-lg p-8 flex flex-col items-center text-center lg:w-1/3"
    >
      <h2 class="text-2xl font-bold text-gray-800 mb-1">
        <%= user.name || user.username %>
      </h2>
      <p class="text-blue-600 font-medium mb-4">Role: <%= user.role %></p>

      <div class="flex gap-4">
        <a
          href="/profile/edit"
          class="px-6 py-2 bg-blue-600 text-white rounded-xl shadow hover:bg-blue-700 transition"
        >
          Edit
        </a>
      </div>
    </div>

    <!-- Personal Information Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8 lg:w-2/3">
      <h1 class="text-2xl font-bold text-gray-800 mb-6">
        Personal Information
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <p class="font-semibold text-gray-700">Name</p>
          <p class="text-gray-600"><%= user.name %></p>
        </div>
        <div>
          <p class="font-semibold text-gray-700">Email</p>
          <p class="text-gray-600"><%= user.email %></p>
        </div>
        <div>
          <p class="font-semibold text-gray-700">Date of Birth</p>
          <p class="text-gray-600"><%= user.date_of_birth %></p>
        </div>
        <div>
          <p class="font-semibold text-gray-700">National ID</p>
          <p class="text-gray-600"><%= user.national_id %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
