<%- include('../partials/header', { title: "Request Service" }) %> <%-
include('../partials/navbar-citizen.ejs') %>
<script>
  const btn = document.getElementById("notif-btn");
  const dropdown = document.getElementById("notif-dropdown");

  btn.addEventListener("click", () => {
    dropdown.classList.toggle("hidden");
  });

  // Optional: close dropdown if clicked outside
  window.addEventListener("click", (e) => {
    if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>

<div class="max-w-xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">Request a Service</h2>

  <form
    action="/citizen/request/<%= serviceId %>"
    method="POST"
    enctype="multipart/form-data"
    class="space-y-4 bg-white p-6 rounded-lg shadow"
  >
    <label for="name">
      <span class="text-gray-700">Full Name</span>
      <input
        type="text"
        name="name"
        id=""
        class="mt-1 block w-full border rounded p-2"
      />
    </label>

<input type="hidden" name="serviceId" value="<%= serviceId %>" />

    <label for="name">
      <span class="text-gray-700">National ID</span>
      <input
        type="text"
        name="national_id"
        id=""
        class="mt-1 block w-full border rounded p-2"
      />
    </label>
    <label for="name">
      <span class="text-gray-700">Date of Birth</span>
      <input
        type="date"
        name="dob"
        id=""
        class="mt-1 block w-full border rounded p-2"
      />
    </label>
    <label for="name">
      <span class="text-gray-700">Email </span>
      <input
        type="text"
        name="email"
        id=""
        class="mt-1 block w-full border rounded p-2"
      />
    </label>

    <!-- Dynamic fields -->
<% fields.forEach(field => { %>
  <label class="block mt-2">
    <span class="text-gray-700"><%= field.label %></span>

    <% if (field.type === 'select' && field.options) { %>
        <select name="<%= field.name %>" class="mt-1 block w-full border rounded p-2" <%= field.required ? 'required' : '' %>>
        <% field.options.forEach(option => { %>
          <option value="<%= option %>"><%= option %></option>
        <% }) %>
      </select>
    <% } else { %>
      <input type="<%= field.type %>" name="<%= field.name %>" class="mt-1 block w-full border rounded p-2" <%= field.required ? 'required' : '' %> />
    <% } %>
  </label>
<% }) %>


  <label class="block">
    <span class="text-gray-700">Upload Documents<em>(jpg,pdf)</em></span>
    <input
      type="file"
      name="documents"
      class="mt-1 block w-full border rounded p-2"
      ,
      multiple
    />
  </label>

  <label class="block">
    <span class="text-gray-700">Optional Note</span>
    <textarea name="note" class="w-full mt-1 p-2 border rounded"></textarea>
  </label>

  <button
    type="submit"
    class="w-full py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
  >
    Submit Request
  </button>
  </form>
</div>

<%- include('../partials/footer') %>
