<%- include('../partials/header', { title: "My Requests" }) %> <%-
include('../partials/navbar-citizen.ejs') %> <% if (success_msg &&
success_msg.length > 0) { %>
<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md mb-4"
>
  <%= success_msg[0] %>
</div>
<% } %> <% if (error_msg && error_msg.length > 0) { %>
<div class="bg-red-100 text-red-800 px-4 py-2 rounded-lg shadow-md mb-4">
  <%= error_msg[0] %>
</div>
<% } %>
<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);
</script>
<div class="max-w-5xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">My Requests</h2>

  <!-- Search and Filter Form -->
  <div class="max-w-6xl mx-auto p-6 mb-4 bg-white shadow rounded-lg">
    <h3 class="font-semibold mb-2">Search and Filter</h3>
    <form action="/citizen/history" method="GET" class="search-form">
      <input
        type="text"
        name="service_name"
        placeholder="Service Name"
        value="<%= filters.service_name || '' %>"
      />

      <select name="status">
        <option value="">-- Status --</option>
        <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>

      <label for="startDate">From: </label>
      <input
        type="date"
        name="startDate"
        value="<%= filters.startDate || '' %>"
      />
      <label for="endDate">To: </label>
      <input
        type="date"
        name="endDate"
        value="<%= filters.endDate || '' %>"
      />

      <button type="submit">Search</button>
    </form>
  </div>

  <table class="w-full border-collapse bg-white shadow rounded-lg">
    <thead>
      <tr class="bg-gray-100">
        <th class="p-3 text-left">Service</th>
        <th class="p-3 text-left">Status</th>
        <th class="p-3 text-left">Submitted On</th>
        <th class="p-3 text-left">Fee</th>
        <th class="p-3 text-left">Payment</th>
        <th class="p-3 text-left">Delete</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(req => { %>
      <tr class="border-b">
        <td class="p-3"><%= req.service_name %></td>
        <td class="p-3">
          <% if(req.status === "approved") { %>
          <span class="text-green-600 font-bold"><%= req.status %></span>
          <% } else if(req.status === "rejected") { %>
          <span class="text-red-600 font-bold"><%= req.status %></span>
          <% } else { %>
          <span class="text-yellow-600 font-semibold"><%= req.status %></span>
          <% } %>
        </td>
        <td class="p-3"><%= req.created_at.toDateString() %></td>
        <td class="p-3"><%= req.service_fee %></td>

        <td class="p-3">
          <% if(req.service_fee > 0 && !req.payment_status) { %>
          <form
            action="/citizen/pay/<%= req.id %>"
            method="POST"
            style="display: inline"
          >
            <button
              type="submit"
              class="text-blue-600 underline hover:text-blue-800"
            >
              Pay Now
            </button>
          </form>
          <% } else if(req.payment_status === "paid") { %>
          <span class="text-green-600">Paid</span>
          <% } else { %>
          <span>-</span>
          <% } %>
        </td>

        <td>
          <form
            action="/citizen/delete/<%= req.id %>"
            method="POST"
            style="display: inline"
            onsubmit="return confirm('Are you sure you want to cancel this request?');"
          >
            <button type="submit" class="text-red-600 underline">Cancel</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
