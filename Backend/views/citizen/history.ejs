<%- include('../partials/header', { title: "My Requests" }) %> <%-
include('../partials/navbar-citizen.ejs') %> <% if (success_msg &&
success_msg.length > 0) { %>

<div
  id="flash-success"
  class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md mb-4"
>
  <%= success_msg[0] %>
</div>
<% } %> <% if (error_msg && error_msg.length > 0) { %>
<div class="bg-red-100 text-red-800 px-4 py-2 rounded-lg shadow-md mb-4">
  <%= error_msg[0] %>
</div>
<% } %>

<script>
  setTimeout(function () {
    const flash = document.getElementById("flash-success");
    if (flash) flash.style.display = "none";
  }, 2000);

  const btn = document.getElementById("notif-btn");
  const dropdown = document.getElementById("notif-dropdown");

  btn.addEventListener("click", () => {
    dropdown.classList.toggle("hidden");
  });

  // Optional: close dropdown if clicked outside
  window.addEventListener("click", (e) => {
    if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>

<div class="max-w-5xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-4">My Requests</h2>

  <!-- Search and Filter Form -->
  <div class="max-w-6xl mx-auto p-6 mb-4 bg-white shadow rounded-lg">
    <h3 class="font-semibold mb-2">Search and Filter</h3>
    <form action="/citizen/history" method="GET" class="flex flex-wrap gap-2 items-center">
      <input
        type="text"
        name="service_name"
        placeholder="Service Name"
        value="<%= filters.service_name || '' %>"
        class="border rounded p-2 text-sm"
      />

      <select name="status" class="border rounded p-2 text-sm">
        <option value="">-- Status --</option>
        <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>

      <label class="text-sm">From:</label>
      <input
        type="date"
        name="startDate"
        value="<%= filters.startDate || '' %>"
        class="border rounded p-2 text-sm"
      />

      <label class="text-sm">To:</label>
      <input
        type="date"
        name="endDate"
        value="<%= filters.endDate || '' %>"
        class="border rounded p-2 text-sm"
      />

      <button type="submit" class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600">Search</button>
      <a href="/citizen/history" class="bg-gray-400 text-white px-3 py-1 rounded hover:bg-gray-500">Clear</a>
    </form>
  </div>

  <% if (requests.length > 0) { %>

  <!-- Responsive Table Wrapper -->
  <div class="overflow-auto rounded-lg shadow hidden md:block">
    <table class="w-full border-collapse bg-white">
      <thead class="bg-gray-50 border-b-2 border-gray-200">
        <tr>
          <th class="w-48 p-3 text-sm font-semibold tracking-wide text-left">Service</th>
          <th class="w-32 p-3 text-sm font-semibold tracking-wide text-left">Status</th>
          <th class="w-32 p-3 text-sm font-semibold tracking-wide text-left">Submitted On</th>
          <th class="w-20 p-3 text-sm font-semibold tracking-wide text-left">Fee</th>
          <th class="w-32 p-3 text-sm font-semibold tracking-wide text-left">Payment</th>
          <th class="w-20 p-3 text-sm font-semibold tracking-wide text-left">Delete</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% requests.forEach(req => { %>
        <tr class="odd:bg-white even:bg-gray-50">
          <td class="p-3 text-sm text-gray-700"><%= req.service_name %></td>
          <td class="p-3">
            <% if(req.status === "approved") { %>
              <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-green-800 bg-green-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
            <% } else if(req.status === "rejected") { %>
              <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-red-800 bg-red-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
            <% } else { %>
              <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-yellow-800 bg-yellow-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
            <% } %>
          </td>
          <td class="p-3 text-sm text-gray-700 whitespace-nowrap"><%= req.created_at.toDateString() %></td>
          <td class="p-3 text-sm text-gray-700"><%= req.service_fee %></td>
          <td class="p-3 text-sm text-gray-700  whitespace-nowrap">
            <% if(req.service_fee > 0 && !req.payment_status) { %>
              <a href="/success" class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">Complete Payment</a>
            <% } else if(req.payment_status === "paid") { %>
              <span class="text-green-600 font-semibold">Paid</span>
            <% } else { %>
              <span>-</span>
            <% } %>
          </td>
          <td class="p-3">
            <form
              action="/citizen/delete/<%= req.id %>"
              method="POST"
              onsubmit="return confirm('Are you sure you want to cancel this request?');"
            >
              <button type="submit" class="text-red-600 font-semibold hover:underline">Cancel</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Card Layout -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:hidden">
    <% requests.forEach(req => { %>
    <div class="bg-white p-4 rounded-lg shadow space-y-3">
      <div class="flex items-center space-x-2 text-sm">
        <span class="text-blue-500 font-bold"><%= req.service_name %></span>
      </div>
      <div class="text-gray-500 text-sm"><%= req.created_at.toDateString() %></div>
      <div>
        <% if(req.status === "approved") { %>
          <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-green-800 bg-green-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
        <% } else if(req.status === "rejected") { %>
          <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-red-800 bg-red-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
        <% } else { %>
          <span class="px-2 py-1 text-xs font-medium uppercase tracking-wider text-yellow-800 bg-yellow-200 bg-opacity-40 rounded-lg"><%= req.status %></span>
        <% } %>
      </div>
      <div class="text-sm text-gray-700">Fee: <%= req.service_fee %></div>
      <div>
        <% if(req.service_fee > 0 && !req.payment_status) { %>
          <a href="/success" class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">Complete Payment</a>
        <% } else if(req.payment_status === "paid") { %>
          <span class="text-green-600 font-semibold">Paid</span>
        <% } else { %>
          <span>-</span>
        <% } %>
      </div>
      <div>
        <form
          action="/citizen/delete/<%= req.id %>"
          method="POST"
          onsubmit="return confirm('Are you sure you want to cancel this request?');"
        >
          <button type="submit" class="text-red-600 font-semibold hover:underline">Cancel</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>

  <% } else { %>
    <p class="text-gray-500 mt-4">No requests matched your search.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
