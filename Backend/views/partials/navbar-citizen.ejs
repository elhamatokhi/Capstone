<nav class="bg-blue-600 text-white p-4 flex justify-between items-center">
  <h1 class="text-xl font-bold">Citizen Portal</h1>

  <ul class="flex space-x-6 items-center">
    <li><a href="/citizen/dashboard" class="hover:underline">Dashboard</a></li>
    <li><a href="/contact" class="hover:underline">Contact</a></li>
    <li class="relative">
      <button id="notif-btn" class="hover:underline flex items-center">
        Notifications <% if (typeof unreadCount !== 'undefined' && unreadCount >
        0) { %>
        <span
          class="ml-1 inline-block w-5 h-5 text-xs bg-red-500 rounded-full text-center"
        >
          <%= unreadCount %>
        </span>
        <% } %>
      </button>

      <!-- Notification dropdown -->
      <div
        id="notif-dropdown"
        class="hidden absolute right-0 mt-2 w-80 bg-white text-black rounded shadow-lg max-h-96 overflow-y-auto z-50"
      >
        <ul class="divide-y divide-gray-200">
          <% if (notifications.length === 0) { %>
          <li class="p-4 text-gray-500">No notifications</li>
          <% } else { %> <% notifications.forEach(n => { %>
          <li
            class="<%= n.is_read ? 'bg-white text-gray-500' : 'bg-blue-100 font-bold' %> p-4 flex justify-between items-center"
          >
            <div>
              <span><%= n.message %></span>
              <small class="block text-xs text-gray-400 mt-1"
                ><%= new Date(n.created_at).toLocaleString() %></small
              >
            </div>
            <% if (!n.is_read) { %>
            <form
              action="/citizen/notifications/<%= n.id %>/read"
              method="POST"
              class="ml-2"
            >
              <button
                type="submit"
                class="text-blue-600 hover:text-blue-800 text-sm font-semibold"
              >
                Mark as read
              </button>
            </form>
            <% } %>
          </li>
          <% }) %> <% } %>
        </ul>
      </div>
    </li>
    <li><a href="/about" class="hover:underline">About</a></li>
    <li><a href="/citizen/history" class="hover:underline">My Requests</a></li>
    <li><a href="/profile" class="hover:underline">Profile</a></li>
    <li><a href="/logout" class="hover:underline text-red-200">Logout</a></li>
  </ul>
</nav>
