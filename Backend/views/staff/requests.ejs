<%- include('../partials/header', { title: "My Assigned Requests" }) %> <%-
include('../partials/navbar-staff') %>

<div class="max-w-6xl mx-auto p-6">
  <h2 class="text-2xl font-bold mb-6">My Assigned Requests</h2>
  <!-- Search and Filter Form -->
  <div class="max-w-6xl mx-auto p-6 mb-4 bg-white shadow rounded-lg">
    <h3 class="font-semibold mb-2">Search and Filter</h3>
    <form action="/staff/requests" method="GET" class="search-form">

      <input
        type="text"
        name="requestId"
        placeholder="Request ID"
        value="<%= filters.requestId || '' %>"
      />

      <select name="status">
        <option value="">-- Status --</option>
        <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>

      <label for="startDate">From: </label>
      <input
        type="date"
        name="startDate"
        value="<%= filters.startDate || '' %>"
      />
      <label for="endDate">To: </label>
      <input
        type="date"
        name="endDate"
        value="<%= filters.endDate || '' %>"
      />

      <button type="submit">Search</button>
      <a href="/staff/requests" class="bg-gray-400 text-white px-3 py-1 rounded hover:bg-gray-500">Clear</a>
    </form>
  </div>

  <% if (requests && requests.length > 0) { %>
  <table class="min-w-full bg-white shadow rounded-lg overflow-hidden">
    <thead class="bg-gray-100">
      <tr>
        <th class="py-3 px-4 text-left">Request ID</th>
        <th class="py-3 px-4 text-left">Service</th>
        <th class="py-3 px-4 text-left">Status</th>
        <th class="py-3 px-4 text-left">Comments</th>
        <th class="py-3 px-4 text-left">Created At</th>
        <th class="py-3 px-4 text-left">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(r => { %>
      <tr class="border-b hover:bg-gray-50">
        <td class="py-3 px-4"><%= r.id %></td>
        <td class="py-3 px-4"><%= r.service_name || '—' %></td>
        <td class="py-3 px-4">
          <span
            class="px-2 py-1 rounded text-sm <%= r.status === 'submitted' ? 'bg-yellow-100 text-yellow-700' : '' %> <%= r.status === 'approved' ? 'bg-green-100 text-green-700' : '' %> <%= r.status === 'rejected' ? 'bg-red-100 text-red-700' : '' %> <%= r.status === 'under_review' ? 'bg-blue-100 text-blue-700' : '' %>"
          >
            <%= r.status %>
          </span>
        </td>
        <td class="py-3 px-4"><%= r.comments || '—' %></td>
        <td class="py-3 px-4"><%= r.created_at %></td>
        <td class="py-3 px-4">
          <a href="/requests/<%= r.id %>" class="text-blue-600 hover:underline"
            >View</a
          >
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-gray-600">You have no assigned requests at the moment.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
