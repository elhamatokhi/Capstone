<%- include('../partials/header', { title: "Department Head Dashboard" }) %> <%-
include('../partials/navbar-department_head') %> <!-- Flash messages -->
<% if (success_msg && success_msg.length > 0) { %>
  <div
    id="flash-success"
    class="bg-green-100 text-green-800 px-4 py-2 rounded-lg shadow-md mb-4 transition-all duration-500"
  >
    <%= success_msg[0] %>
  </div>
<% } %>

<% if (error_msg && error_msg.length > 0) { %>
  <div
    id="flash-error"
    class="bg-red-100 text-red-800 px-4 py-2 rounded-lg shadow-md mb-4 transition-all duration-500"
  >
    <%= error_msg[0] %>
  </div>
<% } %>

<script>
  setTimeout(() => {
    const flash = document.getElementById("flash-success");
    const failFlash = document.getElementById("flash-error");
    if (flash) flash.classList.add("opacity-0", "transition-opacity", "duration-500");
    if (failFlash) failFlash.classList.add("opacity-0", "transition-opacity", "duration-500");
  }, 3000);
</script>

  <!-- Search & Filter Form -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h3 class="font-semibold mb-4 text-lg">Search and Filter</h3>
    <form action="/department_head/requests" method="GET" class="flex flex-wrap gap-3 items-end">

      <input
        type="text"
        name="requestId"
        placeholder="Request ID"
        value="<%= filters.requestId || '' %>"
        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <select name="status" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">-- Status --</option>
        <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>

      <div class="flex items-center gap-2">
        <label for="startDate">From:</label>
        <input
          type="date"
          name="startDate"
          value="<%= filters.startDate || '' %>"
          class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="flex items-center gap-2">
        <label for="endDate">To:</label>
        <input
          type="date"
          name="endDate"
          value="<%= filters.endDate || '' %>"
          class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors">
        Search
      </button>

      <a href="/department_head/requests" class="bg-gray-400 text-white px-4 py-2 rounded hover:bg-gray-500 transition-colors">
        Clear
      </a>

    </form>
  </div>
  <!-- Requests Table -->
  <% if (requests && requests.length > 0) { %>
    <!-- Requests Table (desktop only) -->
<div class="bg-white shadow rounded-lg p-4 overflow-x-auto hidden md:block">
  <h3 class="font-semibold mb-4">Requests for Your Department</h3>

  <% if (requests && requests.length > 0) { %>
    <table class="w-full whitespace-nowrap">
      <thead class="bg-gray-50 border-b-2 border-gray-200">
        <tr>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-24">Request ID</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Citizen</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Service</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-24">Status</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left">Comments</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-32">Created At</th>
          <th class="p-3 text-sm font-semibold tracking-wide text-left w-32">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% requests.forEach(r => { %>
          <tr class="odd:bg-white even:bg-gray-50">
            <td class="p-3 text-sm">
              <a href="/requests/<%= r.id %>" class="font-bold text-blue-500 hover:underline">
                #<%= r.id %>
              </a>
            </td>
            <td class="p-3 text-sm text-gray-700"><%= r.citizen_name %></td>
            <td class="p-3 text-sm text-gray-700"><%= r.service_name %></td>
            <td class="p-3 text-sm">
              <span class="p-1.5 text-xs font-medium uppercase tracking-wider rounded-lg
                <%= r.status === 'approved' ? 'bg-green-200 text-green-800 bg-opacity-40' : '' %>
                <%= r.status === 'rejected' ? 'bg-red-200 text-red-800 bg-opacity-40' : '' %>
                <%= r.status === 'under_review' ? 'bg-yellow-200 text-yellow-800 bg-opacity-40' : '' %>
                <%= r.status === 'submitted' ? 'bg-gray-200 text-gray-800 bg-opacity-40' : '' %>">
                <%= r.status %>
              </span>
            </td>
            <td class="p-3 text-sm text-gray-700"><%= r.comments || '—' %></td>
            <td class="p-3 text-sm text-gray-500"><%= r.created_at %></td>
            <td class="p-3 text-sm space-y-2">
              <!-- Example: Update Status -->
              <form action="/requests/<%= r.id %>/status" method="POST" class="flex items-center gap-2">
                <select name="status" class="border rounded px-2 py-1 text-sm">
                  <option value="approved">Approve</option>
                  <option value="rejected">Reject</option>
                  <option value="under_review">Under Review</option>
                </select>
                <button type="submit" class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600 text-sm">
                  Update
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="text-gray-500 mt-4">No requests found for your department.</p>
  <% } %>
</div>

<!-- Mobile Card Layout (hidden on md+) -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:hidden">
  <% if (requests && requests.length > 0) { %>
    <% requests.forEach(r => { %>
      <div class="bg-white p-4 rounded-lg shadow space-y-3">
        <!-- Top Row -->
        <div class="flex items-center justify-between">
          <a href="/requests/<%= r.id %>" class="text-blue-500 font-bold hover:underline">
            #<%= r.id %>
          </a>
          <span class="text-sm text-gray-500"><%= r.created_at %></span>
        </div>

        <!-- Status Badge -->
        <div>
          <span class="p-1.5 text-xs font-medium uppercase tracking-wider rounded-lg
            <%= r.status === 'approved' ? 'bg-green-200 text-green-800 bg-opacity-40' : '' %>
            <%= r.status === 'rejected' ? 'bg-red-200 text-red-800 bg-opacity-40' : '' %>
            <%= r.status === 'under_review' ? 'bg-yellow-200 text-yellow-800 bg-opacity-40' : '' %>
            <%= r.status === 'submitted' ? 'bg-gray-200 text-gray-800 bg-opacity-40' : '' %>">
            <%= r.status %>
          </span>
        </div>

        <!-- Citizen, Service, Comments -->
        <div class="text-sm text-gray-700 space-y-1">
          <p><span class="font-medium">Citizen:</span> <%= r.citizen_name %></p>
          <p><span class="font-medium">Service:</span> <%= r.service_name %></p>
          <p><span class="font-medium">Comments:</span> <%= r.comments || '—' %></p>
        </div>

        <!-- Actions -->
        <div>
          <a href="/requests/<%= r.id %>" class="text-blue-600 hover:underline text-sm">View Details</a>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p class="text-gray-500 mt-4">No requests found for your department.</p>
  <% } %>
</div>

  <% } else { %>
    <p class="text-gray-600 mt-4">No requests found for your department.</p>
  <% } %>


<%- include('../partials/footer') %>
